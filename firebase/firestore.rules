rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validDeadline(data) {
      return data.keys().hasAll(['title', 'courseId', 'dueAt', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'courseId', 'dueAt', 'completed', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 80
        && data.dueAt is timestamp && data.completed is bool
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/deadlines/{deadlineId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validDeadline(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validDeadline(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{uid}/courses/{courseId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['name', 'code', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'code', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0 && request.resource.data.code.size() <= 20
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/study_sessions/{sessionId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['title', 'plannedAt', 'plannedMinutes', 'status', 'startedAt', 'endedAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'plannedAt', 'plannedMinutes', 'status', 'startedAt', 'endedAt', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.plannedAt is timestamp
        && request.resource.data.plannedMinutes is int
        && request.resource.data.plannedMinutes >= 5 && request.resource.data.plannedMinutes <= 180
        && request.resource.data.status == 'planned'
        && request.resource.data.startedAt == null && request.resource.data.endedAt == null
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && (
        (resource.data.status == 'planned' && request.resource.data.status == 'running'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
          && request.resource.data.startedAt == request.time)
        || (resource.data.status == 'running' && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
          && request.resource.data.endedAt == request.time)
      );
    }
    match /users/{uid}/reports/{reportId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['fileName', 'url', 'ownerId', 'createdAt', 'itemCount', 'objectPath', 'storageProvider'])
        && request.resource.data.keys().hasOnly(['fileName', 'url', 'ownerId', 'createdAt', 'itemCount', 'objectPath', 'storageProvider'])
        && request.resource.data.ownerId == uid
        && request.resource.data.fileName == 'deadline-mate-' + reportId + '.pdf'
        && request.resource.data.objectPath is string
        && request.resource.data.objectPath.size() > 0 && request.resource.data.objectPath.size() <= 1024
        && request.resource.data.url is string && request.resource.data.url.size() <= 4096
        && ((request.resource.data.storageProvider == 'firebase'
          && request.resource.data.objectPath == 'reports/' + uid + '/' + request.resource.data.fileName
          && request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*'))
          || (request.resource.data.storageProvider == 'cloudinary'
          && request.resource.data.url.matches('https://res[.]cloudinary[.]com/[a-zA-Z0-9_-]+/raw/upload/.*')))
        && request.resource.data.itemCount is int && request.resource.data.itemCount >= 0
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/notifications/{messageId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['title', 'body', 'targetType', 'targetId', 'read', 'receivedAt'])
        && request.resource.data.keys().hasOnly(['title', 'body', 'targetType', 'targetId', 'read', 'receivedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000
        && request.resource.data.targetType in ['deadline', 'notifications']
        && (request.resource.data.targetId == null ||
          (request.resource.data.targetId is string && request.resource.data.targetId.size() <= 200))
        && request.resource.data.read == false
        && request.resource.data.receivedAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    // Unknown paths stay denied.
    match /{document=**} { allow read, write: if false; }
  }
}
